#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp BSPC
                &kp A &kp S &kp D &kp F &kp G &kp H &kp K &kp L &kp SEMI &kp SQT &kp RET
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LALT &kp ESC &kp C_VOICE_COMMAND &kp SPACE &mo 1 &kp LEFT &kp UP &kp DOWN &kp RIGHT
            >;
        };

        sym_layer {
            bindings = <
                &kp HASH &kp EXCL &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDER &kp AT
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp RBKT &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp COLON &kp DQT &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp LT &kp GT &kp QMARK &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
